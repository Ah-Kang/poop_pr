# Kakao Developers > App > Platform key > REST API key
KAKAO_REST_API_KEY=replace_with_your_rest_api_key

# Kakao Developers > App > Platform key > REST API key > Client secret
# Keep this value private. Never paste it into chat or commit it to Git.
KAKAO_CLIENT_SECRET=replace_with_your_client_secret

KAKAO_REDIRECT_URI=http://localhost:3001/auth/kakao/callback
FRONTEND_URL=http://localhost:5173
SESSION_SECRET=replace_with_a_long_random_string
PORT=3001
NODE_ENV=development

# Supabase Dashboard > Connect > Session pooler
DATABASE_URL=
DATABASE_SSL=true

# Supabase Project Settings > API Keys (server only)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

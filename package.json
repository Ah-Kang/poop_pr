{
  "name": "poop-pr",
  "private": true,
  "version": "0.1.27",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "dev:local": "node scripts/dev-local.js",
    "dev:server": "node server/index.js",
    "dev:server:watch": "node --watch server/index.js",
    "start": "node server/index.js",
    "check:server": "node --check server/index.js && node --check server/database.js",
    "test:progression": "node --test tests/poop-progression.test.js tests/growth-database.test.js tests/growth-client.test.js",
    "test:puzzle": "node --test src/minigames/match3.test.js",
    "test:economy": "npm run build && node --test tests/economy.test.js tests/economy-api.test.js",
    "db:check": "node server/check-database.js",
    "db:migrate:sqlite": "node server/migrate-sqlite-to-postgres.js",
    "build": "vite build",
    "preview": "vite preview",
    "test:cosmetics": "node --test tests/cosmetics.test.js",
    "skins:build": "python3 scripts/build-skin-assets.py",
    "test:analytics": "node --test tests/analytics.test.js"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "pg": "^8.22.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.3",
    "vite": "^5.4.1"
  }
}
